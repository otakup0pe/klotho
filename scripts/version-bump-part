#!/bin/sh
set -eu

messages=$(cat)

if printf '%s\n' "$messages" | grep -qiE '#major|bump:major'; then
    printf 'major\n'
elif printf '%s\n' "$messages" | grep -qiE '#minor|bump:minor'; then
    printf 'minor\n'
elif printf '%s\n' "$messages" | grep -qiE '#patch|bump:patch'; then
    printf 'patch\n'
fi

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {erl_openrouter, {git, "https://github.com/otakup0pe/erl_openrouter.git", {tag, "0.5.0"}}},
    {erl_mcp, {git, "https://github.com/otakup0pe/erl_mcp.git", {tag, "0.2.0"}}}
]}.

{profiles, [
    {test, [
        {deps, [
            {meck, "0.9.2"}
        ]},
        {erl_opts, [debug_info, nowarn_export_all]},
        {cover_enabled, true},
        {cover_opts, [verbose]},
        {cover_export_enabled, true},
        {cover_spec, "cover.spec"}
    ]}
]}.

{ct_opts, [{dir, "test"}]}.

{dialyzer, [
    {warnings, [
        error_handling,
        underspecs,
        unmatched_returns
    ]},
    {plt_extra_apps, [erl_openrouter, erl_mcp]}
]}.

{shell, [{apps, [klotho]}]}.
